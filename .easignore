# =============================================================================
# EAS Build archive ignore — monorepo root
# =============================================================================
# When this file exists, EAS ignores .gitignore. Keep both sets of rules here.
# Paths are relative to the git repository root.
# Docs: https://docs.expo.dev/build-reference/easignore/
#
# Local check (should be ~10–15 MB uncompressed after filters):
#   node -e "..."  or re-run: eas build and read "Compressed project files (X MB)"
# Target: compressed archive under ~20 MB.
# =============================================================================

# ----- Always (also enforced by EAS defaults) -----
.git
node_modules

# ----- Root .gitignore -----
.pnp
.pnp.js
coverage/
*.log
.next/
out/
dist/
build/
*.tsbuildinfo
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.env*.local
.env
.env.*
.vercel
.turbo
.turbo-cache
.idea/
.vscode/
*.swp
*.swo
*~
.cursorindexingignore
.specstory
.worktrees/
.omc

# generated: only keep mobile design-tokens + assets generated (then narrow below)
**/generated/
!apps/mobile/generated/
!apps/mobile/generated/design-tokens/
!apps/mobile/generated/design-tokens/**
!packages/assets/generated/
!packages/assets/generated/**

**/src/**/*.js
**/src/**/*.js.map

# ----- apps/mobile local ignores -----
apps/mobile/node_modules/
apps/mobile/.expo/
apps/mobile/dist/
apps/mobile/web-build/
apps/mobile/expo-env.d.ts
apps/mobile/.kotlin/
apps/mobile/ios
apps/mobile/ios/
apps/mobile/android
apps/mobile/android/
apps/mobile/.metro-health-check*
apps/mobile/.tamagui
apps/mobile/.tamagui/
# unused local copies (app uses @daodao/assets quiz json instead)
apps/mobile/assets/animations/

# ----- Other monorepo apps (not mobile) -----
apps/website/
apps/product/

# ----- Docs / tooling -----
docs/
docker/
.github/
.claude/
.cursor/
.superpowers/
.husky/
/LICENSE
/PLAN.md
/ADMIN-WIREFRAMES.md
/sonar-project.properties
/docker-compose.yaml
/docker-compose.local.yml.backup
/vitest.workspace.ts
/CLAUDE.md
/AGENTS.md
/README.md
**/*.map

# ----- packages/assets: drop what mobile never loads -----

# Marketing / unused image trees (non-SVG media + leftovers)
packages/assets/images/landing-page/**
packages/assets/images/island/**
packages/assets/images/login/**
packages/assets/images/resource/**
packages/assets/images/users/**
packages/assets/images/action-maker/**
packages/assets/images/common/**

# Source SVGs: RN resolves @daodao/assets/images/**/*.svg → generated/**/*.native.tsx
# (package exports + metro packageExports). Source .svg not needed on EAS.
packages/assets/images/**/*.svg

# Web-only generated components; keep *.native.tsx for RN
packages/assets/generated/**/*.tsx
!packages/assets/generated/**/*.native.tsx

# landing-page generated (web+native) — AFTER native re-include so it stays excluded
# index.ts no longer re-exports these
packages/assets/generated/landing-page/**

# unused feature modules' generated icons (index may still list them — keep files
# that barrel exports need; only drop landing + mascot which we removed from index)
packages/assets/generated/icon/mascot-basic.tsx
packages/assets/generated/icon/mascot-basic.native.tsx
packages/assets/images/icon/mascot-basic.svg

# dialog: keep success.png only (used by CheckInSuccessDialog)
packages/assets/images/dialog/info.png
packages/assets/images/dialog/warning.png

# Unused feature packages
packages/features/action-maker/
packages/features/mention/

# Secrets
**/*service-account*.json
**/google-services.json
**/GoogleService-Info.plist
**/*.jks
**/*.p8
**/*.p12
**/*.mobileprovision
**/*.keystore
