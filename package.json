    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "sitemap": "next-sitemap",
    "typegen": "next typegen",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --fix --quiet",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:tailwind": "prettier --write \"**/*.{js,jsx,ts,tsx}\"",
    "ts:check": "tsc --noEmit --incremental false",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:dry-run": "wrangler deploy --outdir bundled/ --dry-run",
    "cf:build:dry-run": "npm run cf:build && npm run cf:dry-run",
    "preview": "npm run cf:build  && opennextjs-cloudflare preview",
    "deploy": "npm run cf:build  && opennextjs-cloudflare deploy",
    "generate:api": "orval",
    "i18n:fetch": "dotenvx run -- node scripts/google-app-script/fetch-i18n.js"
  },
