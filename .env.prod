# 正式環境配置範例
# 複製此文件為 .env.prod 並填入實際值
# 警告：不要將此文件提交到 Git！

# ============================================
# 基本配置
# ============================================
NODE_ENV=production

# ============================================
# 網站信息
# ============================================
NEXT_PUBLIC_SITE_URL=https://daodao.so
NEXT_PUBLIC_SITE_NAME=島島阿學
NEXT_PUBLIC_SITE_DESCRIPTION=島島阿學 - 自主學習社群平台

# ============================================
# API 端點
# ============================================
# 後端 API 基礎 URL
NEXT_PUBLIC_API_BASE_URL=https://dao-server.daoedu.tw/api/v1
# 後端 URL
NEXT_PUBLIC_BACKEND_URL=https://dao-server.daoedu.tw

# ============================================
# 功能開關
# ============================================
# 啟用 Google Analytics
NEXT_PUBLIC_ENABLE_ANALYTICS=true
# 啟用 PWA
NEXT_PUBLIC_ENABLE_PWA=true
# 啟用調試模式
NEXT_PUBLIC_DEBUG_MODE=false

# ============================================
# 第三方服務
# ============================================
# Google Analytics ID (替換為實際值)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Sentry DSN (替換為實際值)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# ============================================
# 其他配置
# ============================================
# 禁用 Next.js 遙測
NEXT_TELEMETRY_DISABLED=1
