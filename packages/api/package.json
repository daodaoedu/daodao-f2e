{
  "name": "@daodao/api",
  "version": "0.0.0",
  "private": true,
  "description": "API client package for DaoDao monorepo (OpenAPI)",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "clean": "pnpm dlx rimraf dist node_modules",
    "gen:types": "gh api repos/daodaoedu/daodao-server/contents/generated/openapi-types.ts --method GET -f ref=dev --jq '.content' | base64 -d > src/types.ts",
    "gen:ai-types": "openapi-typescript https://ai-dev.daodao.so/openapi.json -o src/ai-types.ts",
    "gen": "pnpm gen:types && pnpm gen:ai-types"
  },
  "dependencies": {
    "@daodao/config": "workspace:*",
    "next": "catalog:",
    "openapi-fetch": "^0.15.0",
    "swr": "^2.3.8",
    "swr-openapi": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "openapi-typescript": "^7.10.1",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  }
}
