{
  "name": "@daodao/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "Internationalization package for DaoDao monorepo",
  "main": "./src/index.ts",
  "types": "./src/i18n.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./i18n": "./src/i18n.d.ts",
    "./navigation": "./src/navigation.ts",
    "./plugin": "./src/plugin.ts",
    "./routing": "./src/routing.ts",
    "./middleware": "./src/middleware.ts",
    "./server": "./src/server.ts",
    "./lib/*": "./src/lib/*.ts",
    "./locales/*": "./src/locales/*.json"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "clean": "pnpm dlx rimraf dist node_modules"
  },
  "dependencies": {
    "@daodao/shared": "workspace:*",
    "next-intl": "^4.9.1"
  },
  "devDependencies": {
    "@daodao/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "react": "catalog:"
  }
}
