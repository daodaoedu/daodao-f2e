{
  "name": "@daodao/analytics",
  "version": "0.0.0",
  "private": true,
  "description": "Analytics integrations (Google Analytics, Clarity, PostHog) for DaoDao monorepo",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "clean": "pnpm dlx rimraf dist node_modules",
    "test": "vitest run",
    "activation:report": "tsx scripts/activation-report.ts"
  },
  "dependencies": {
    "@daodao/config": "workspace:*",
    "date-fns": "catalog:",
    "zod": "catalog:",
    "@daodao/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "tsx": "^4.19.2"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.0.0"
  }
}
