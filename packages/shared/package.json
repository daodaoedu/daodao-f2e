{
  "name": "@daodao/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared utilities and components for DaoDao monorepo",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./constants/*": "./src/constants/*.ts",
    "./providers/*": "./src/providers/*.tsx"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "clean": "pnpm dlx rimraf dist node_modules"
  },
  "dependencies": {
    "date-fns": "catalog:",
    "html-to-image": "^1.11.13",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@daodao/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-hook-form": "catalog:"
  }
}
