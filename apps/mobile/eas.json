{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_API_URL": "https://server-dev.daodao.so",
        "EXPO_PUBLIC_AI_API_URL": "https://ai-dev.daodao.so",
        "NEXT_PUBLIC_API_URL": "https://server-dev.daodao.so",
        "NEXT_PUBLIC_AI_API_URL": "https://ai-dev.daodao.so"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://server-dev.daodao.so",
        "EXPO_PUBLIC_AI_API_URL": "https://ai-dev.daodao.so",
        "NEXT_PUBLIC_API_URL": "https://server-dev.daodao.so",
        "NEXT_PUBLIC_AI_API_URL": "https://ai-dev.daodao.so"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://server.daodao.so",
        "EXPO_PUBLIC_AI_API_URL": "https://ai.daodao.so",
        "NEXT_PUBLIC_API_URL": "https://server.daodao.so",
        "NEXT_PUBLIC_AI_API_URL": "https://ai.daodao.so"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "${APPLE_ID}",
        "ascAppId": "${ASC_APP_ID}",
        "appleTeamId": "${APPLE_TEAM_ID}"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    },
    "personal": {
      "ios": {
        "appleTeamId": "G5GY9SQ4F7",
        "ascAppId": "6789877267"
      }
    },
    "personal-dev": {
      "ios": {
        "appleTeamId": "G5GY9SQ4F7",
        "ascAppId": "6789942778"
      }
    }
  }
}
