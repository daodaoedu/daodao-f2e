{
  "name": "@daodao/product",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "postinstall": "husky && pnpm typegen",
    "typegen": "next typegen",
    "predev": "node scripts/sync-island-models.mjs",
    "dev": "next dev --turbopack -p 3001",
    "prebuild": "node scripts/sync-island-models.mjs",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --config=../../playwright.config.ts",
    "test:e2e:future-letter": "playwright test --config=../../playwright.config.ts e2e/future-letter --project=chromium",
    "test:e2e:future-letter:record": "playwright test --config=../../playwright.config.ts e2e/future-letter --project=chromium",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "clean": "pnpm dlx rimraf .next out node_modules"
  },
  "dependencies": {
    "@daodao/analytics": "workspace:*",
    "@daodao/api": "workspace:*",
    "@daodao/assets": "workspace:*",
    "@daodao/auth": "workspace:*",
    "@daodao/features-island-engine": "workspace:*",
    "@daodao/features-mention": "workspace:*",
    "@daodao/features-quiz": "workspace:*",
    "@daodao/i18n": "workspace:*",
    "@daodao/shared": "workspace:*",
    "@daodao/ui": "workspace:*",
    "@hookform/resolvers": "catalog:",
    "@next/env": "catalog:",
    "@vercel/og": "^0.8.6",
    "add": "^2.0.6",
    "browser-image-compression": "^2.0.2",
    "date-fns": "catalog:",
    "gsap": "catalog:",
    "lottie-react": "catalog:",
    "lru-cache": "^11.2.5",
    "lucide-react": "catalog:",
    "matter-js": "^0.20.0",
    "motion": "catalog:",
    "next": "catalog:",
    "poly-decomp-es": "^0.4.2",
    "qrcode": "^1.5.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "recharts": "catalog:",
    "swr": "^2.2.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@daodao/config": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "catalog:",
    "@types/matter-js": "^0.20.2",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "bullmq": "^5.81.3",
    "pg": "^8.23.0",
    "typescript": "catalog:",
    "vitest": "^4.1.2"
  }
}
