{
  "extends": "@daodao/config/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/src/*": ["./src/*"],
      "@/public/*": ["./public/*"]
    },
    "jsx": "preserve"
  },
  "include": [
    "../packages/i18n/src/i18n.d.ts",
    ".next/types/**/*",
    "next-env.d.ts",
    "next.config.ts",
    "src/**/*",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "out"]
}
