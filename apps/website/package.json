{
  "name": "@daodao/website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "postinstall": "husky && pnpm typegen",
    "typegen": "next typegen",
    "dev": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "pnpm dlx serve@latest out -p 3000",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "clean": "pnpm dlx rimraf .next out node_modules",
    "test:blog": "vitest run --config vitest.blog.config.ts",
    "prebuild": "pnpm --filter @daodao/config generate:env && tsx scripts/prepare-blog-assets.ts",
    "test": "pnpm run test:blog",
    "postbuild": "tsx scripts/finalize-blog-export.ts"
  },
  "dependencies": {
    "@daodao/analytics": "workspace:*",
    "@daodao/api": "workspace:*",
    "@daodao/assets": "workspace:*",
    "@daodao/auth": "workspace:*",
    "@daodao/features-action-maker": "workspace:*",
    "@daodao/features-quiz": "workspace:*",
    "@daodao/i18n": "workspace:*",
    "@daodao/shared": "workspace:*",
    "@daodao/ui": "workspace:*",
    "@next/env": "catalog:",
    "lottie-react": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@daodao/blog-content": "workspace:*",
    "react-markdown": "catalog:",
    "remark-gfm": "catalog:",
    "rehype-sanitize": "catalog:",
    "date-fns": "catalog:",
    "mdast-util-from-markdown": "2.0.2"
  },
  "devDependencies": {
    "@daodao/config": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "@types/mdast": "^4.0.4",
    "tsx": "^4.19.2"
  }
}
